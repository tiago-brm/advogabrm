# AdvogaBRM - Environment Variables
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com credenciais reais.

# ─── Supabase ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ─── Worker (server-side, sem prefixo VITE_) ─────────────────
# Essas variáveis são usadas pelo worker.js no servidor — nunca no frontend!
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ─── Segredo Interno do Worker ───────────────────────────────
# Gere um valor aleatório forte: openssl rand -hex 32
WORKER_SECRET=seu_segredo_interno_aqui

# ─── DataJud API ─────────────────────────────────────────────
# Chave pública da API do CNJ — pode deixar em branco para usar o padrão
DATAJUD_API_KEY=

# ─── SMTP Secret (Blue Team) ─────────────────────────────────
# Chave usada para criptografar senhas SMTP no banco via pgcrypto
# Gere com: openssl rand -hex 32
SMTP_ENCRYPTION_KEY=sua_chave_de_criptografia_aqui
